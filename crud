    align-self: flex-start;
    background: #20242d;

    border-bottom-left-radius: 4px;
}

.mensagem small {
    display: block;
    font-size: 9px;
    opacity: .5;
    margin-top: 5px;
}

/* =========================
   BOTÕES DA MENSAGEM
========================= */

.acoes {
    display: flex;
    gap: 5px;
    margin-top: 6px;
}

.acoes button {
    padding: 5px 7px;
    font-size: 9px;
