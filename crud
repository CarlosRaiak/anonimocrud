/* =========================
   CHAT
========================= */

#chat {
    display: none;
    height: 100vh;
    flex-direction: column;
}

/* HEADER */

.header {
    padding: 13px;

    background: #171a21;
    border-bottom: 1px solid #292d37;

    display: flex;
    align-items: center;
    gap: 10px;
}

.header .avatar {
    width: 43px;
    height: 43px;
    min-width: 43px;
}

.usuario {
    flex: 1;
}

.usuario strong {
    font-size: 14px;
}

.online {
