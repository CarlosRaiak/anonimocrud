    display: flex;
    gap: 7px;
}

.envio input {
    flex: 1;
    border-radius: 22px;
}

.enviar {
    width: 48px;
    height: 48px;

    padding: 0;

    border-radius: 50%;

    background: #6366f1;
    color: white;

    font-size: 18px;
}

/* =========================
   BOTÃO APAGAR CONVERSA
========================= */

.apagar {
    width: 100%;

    margin-top: 8px;

    background: #28191c;
    color: #ff7979;

    border: 1px solid #48282d;

    font-size: 11px;
}

.sair {
    width: 100%;

    margin-top: 7px;

    background: #20242c;
    color: #aaa;

    border: 1px solid #30343e;

    font-size: 11px;
}

</style>
</head>

<body>

<div class="app">

<!-- ==================================
     INÍCIO
================================== -->

<div id="inicio">

    <div class="logo">

        <div class="logo-icon">
            👤
        </div>

        <h1>
            Chat Anônimo
        </h1>

        <p>
            Converse de forma simples e privada.
        </p>

    </div>


    <!-- PERFIL -->

    <div class="profile">

        <div class="profile-title">
            👤 SEU PERFIL
        </div>

        <div class="profile-content">

            <div class="avatar">
                👤
            </div>

            <input
                id="nome"
                placeholder="Digite seu nome"
                maxlength="20"
            >

        </div>

    </div>


    <button
        class="criar"
        onclick="criarSala()"
    >
        🔐 Criar nova conversa
    </button>


    <div class="divisor">
        OU
    </div>


    <label>
        Código da conversa
    </label>

    <input
        id="codigoEntrada"
        placeholder="Ex: A7K92X"
        maxlength="6"
    >


    <button
        class="entrar"
        onclick="entrarSala()"
    >
        🚪 Entrar na conversa
    </button>

</div>


<!-- ==================================
     CHAT
================================== -->

<div id="chat">

    <!-- HEADER -->

    <div class="header">

        <div class="avatar">
            👤
        </div>

        <div class="usuario">

            <strong id="nomeChat">
                Anônimo
            </strong>

            <div class="online">
                ● Conversa privada
            </div>

        </div>

    </div>


    <!-- SALA -->

    <div class="sala">

        <small>
            Código da conversa
        </small>

        <div
            class="codigo"
            id="codigoSala"
        >
            AAAAAA
        </div>

    </div>


    <!-- MENSAGENS -->

    <div
        class="mensagens"
        id="mensagens"
    >
    </div>


    <!-- PARTE INFERIOR -->

    <div class="bottom">

        <div class="envio">

            <input
                id="textoMensagem"
                placeholder="Digite uma mensagem..."
                onkeydown="enterEnviar(event)"
            >

            <button
                class="enviar"
                onclick="enviarMensagem()"
            >
                ➤
            </button>

        </div>


        <button
            class="apagar"
            onclick="apagarConversa()"
        >
            🗑️ APAGAR CONVERSA INTEIRA
        </button>


        <button
            class="sair"
            onclick="sair()"
        >
            🚪 Sair da conversa
        </button>

    </div>

</div>

</div>


<script>

/* ==================================
   VARIÁVEIS
================================== */

let nomeUsuario = "";
let codigoSala = "";

let mensagens =
    JSON.parse(
        localStorage.getItem("mensagens")
    ) || [];


/* ==================================
   CRIAR SALA
================================== */

function criarSala() {

    nomeUsuario =
        document.getElementById(
            "nome"
        ).value.trim();

    if (!nomeUsuario) {

        nomeUsuario = "Anônimo";

    }

    codigoSala =
        gerarCodigo();

    abrirChat();

}


/* ==================================
   ENTRAR
================================== */

function entrarSala() {

    nomeUsuario =
        document.getElementById(
            "nome"
        ).value.trim();

    if (!nomeUsuario) {

        nomeUsuario = "Anônimo";

    }

    codigoSala =
        document.getElementById(
            "codigoEntrada"
        ).value
        .trim()
        .toUpperCase();


    if (codigoSala.length !== 6) {

        alert(
            "Digite um código de 6 caracteres."
        );

        return;

    }

    abrirChat();

}


/* ==================================
   GERAR CÓDIGO
================================== */

function gerarCodigo() {

    const letras =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

    let codigo = "";

    for (
        let i = 0;
        i < 6;
        i++
    ) {

        codigo +=
            letras[
                Math.floor(
                    Math.random() *
                    letras.length
                )
            ];

    }

    return codigo;

}


/* ==================================
   ABRIR CHAT
================================== */

function abrirChat() {

    document.getElementById(
        "inicio"
    ).style.display = "none";


    document.getElementById(
        "chat"
    ).style.display = "flex";


    document.getElementById(
        "nomeChat"
    ).textContent =
        nomeUsuario;


    document.getElementById(
        "codigoSala"
    ).textContent =
        codigoSala;


    carregarMensagens();

}


/* ==================================
   ENVIAR
================================== */

function enviarMensagem() {

    const input =
        document.getElementById(
            "textoMensagem"
        );

    const texto =
        input.value.trim();


    if (!texto) {

        return;

    }


    const novaMensagem = {

        id: Date.now(),

        nome: nomeUsuario,

        texto: texto,

        horario:
            new Date().toLocaleTimeString(
                "pt-BR",
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            )

    };


    mensagens.push(
        novaMensagem
    );


    salvar();

    input.value = "";

    carregarMensagens();

}


/* ==================================
   MOSTRAR MENSAGENS
================================== */

function carregarMensagens() {

    const area =
        document.getElementById(
            "mensagens"
        );


    area.innerHTML = "";


    mensagens.forEach(
        mensagem => {

            const div =
                document.createElement(
                    "div"
                );


            div.className =
                "mensagem eu";


            div.innerHTML = `

                ${escapeHTML(
                    mensagem.texto
                )}

                <small>
                    ${escapeHTML(
                        mensagem.nome
                    )}
                    •
                    ${mensagem.horario}
                </small>

                <div class="acoes">

                    <button
                        onclick="editarMensagem(${mensagem.id})"
                    >
                        ✏️ Editar
                    </button>

                    <button
                        onclick="apagarMensagem(${mensagem.id})"
                    >
                        🗑️ Apagar
                    </button>

                </div>

            `;


            area.appendChild(div);

        }
    );


    area.scrollTop =
        area.scrollHeight;

}


/* ==================================
   EDITAR
================================== */

function editarMensagem(id) {

    const mensagem =
        mensagens.find(
            m => m.id === id
        );


    if (!mensagem) return;


    const novoTexto =
        prompt(
            "Editar mensagem:",
            mensagem.texto
        );


    if (
        novoTexto === null ||
        novoTexto.trim() === ""
    ) {

        return;

    }


    mensagem.texto =
        novoTexto.trim();


    salvar();

    carregarMensagens();

}


/* ==================================
   APAGAR UMA MENSAGEM
================================== */

function apagarMensagem(id) {

    const confirmar =
        confirm(
            "Apagar esta mensagem?"
        );


    if (!confirmar) return;


    mensagens =
        mensagens.filter(
            m => m.id !== id
        );


    salvar();

    carregarMensagens();

}


/* ==================================
   APAGAR CONVERSA INTEIRA
================================== */

function apagarConversa() {

    const confirmar =
        confirm(
            "⚠️ Tem certeza que deseja apagar TODA a conversa?"
        );


    if (!confirmar) return;


    mensagens = [];


    localStorage.removeItem(
        "mensagens"
    );


    carregarMensagens();


    alert(
        "Conversa apagada!"
    );

}


/* ==================================
   SALVAR
================================== */

function salvar() {

    localStorage.setItem(
        "mensagens",
        JSON.stringify(
            mensagens
        )
    );

}


/* ==================================
   ENTER
================================== */

function enterEnviar(event) {

    if (
        event.key === "Enter"
    ) {

        enviarMensagem();

    }

}


/* ==================================
   SAIR
================================== */

function sair() {

    document.getElementById(
        "chat"
    ).style.display = "none";


    document.getElementById(
        "inicio"
    ).style.display = "block";

}


/* ==================================
   SEGURANÇA
================================== */

function escapeHTML(text) {

    const div =
        document.createElement(
            "div"
        );

    div.textContent = text;

    return div.innerHTML;

}

</script>

</body>
</html>
